# Copy to .env.production and fill in. Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_PUBLIC_URL=https://api.example.com
ADMIN_ORIGIN=https://admin.example.com
HTTP_PORT=8080

POSTGRES_USER=ctp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ctp
REDIS_PASSWORD=change-me
# Connections per API or worker process. (api replicas + worker replicas) x this must stay below max_connections (300).
DB_POOL_PER_PROCESS=15

JWT_ACCESS_SECRET=change-me
JWT_CUSTOMER_SECRET=change-me
# Losing this key makes stored gateway credentials, MFA secrets and QR tokens unreadable.
# Keep a copy in a secrets manager, separate from database backups.
DATA_ENCRYPTION_KEY=change-me
METRICS_TOKEN=change-me

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=21600
