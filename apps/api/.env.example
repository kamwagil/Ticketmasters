# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of this API (used in webhook URLs, tracking links, sandbox checkout)
API_PUBLIC_URL=http://localhost:4000
ADMIN_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://ctp:ctp_dev_password@localhost:5544/ctp?schema=public&connection_limit=20
REDIS_URL=redis://localhost:6390

# ── Secrets (generate fresh values per environment; never commit real ones) ──
# 32+ random bytes each. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_0123456789abcdef
JWT_CUSTOMER_SECRET=dev_only_customer_secret_change_me_0123456789abcdef
# 32-byte key, base64. Encrypts gateway credentials, MFA secrets, QR tokens, payout details.
DATA_ENCRYPTION_KEY=ZGV2X29ubHlfMzJfYnl0ZV9rZXlfMDEyMzQ1Njc4OWFi

# ── Queues ───────────────────────────────────────────────────────────
# bullmq = Redis-backed workers (production). inline = run jobs in-process (tests only).
QUEUE_MODE=bullmq
# Set to false on API-only replicas when dedicated worker containers run `start:worker`.
RUN_WORKERS=true
# Prefix for queue keys, so several environments can share one Redis safely.
QUEUE_PREFIX=ctp

# ── Email (SMTP). Dev default points at Mailpit from docker-compose ──
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── SMS (Africa's Talking). Leave empty to disable; messages are logged as SKIPPED ──
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ── WhatsApp (Meta WhatsApp Cloud API). Leave empty to disable ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Object storage ───────────────────────────────────────────────────
# local = filesystem under ./storage (dev). s3 = any S3-compatible store.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=ctp-media
S3_ACCESS_KEY=ctp_dev_access
S3_SECRET_KEY=ctp_dev_secret_key
S3_PUBLIC_URL=

# ── Payments ─────────────────────────────────────────────────────────
# Gateway secret keys are NOT configured here. They are entered per merchant account in
# Admin → Integrations and stored encrypted in payment_provider_accounts.
# The sandbox provider is refused when NODE_ENV=production unless this is true.
ALLOW_SANDBOX_PROVIDER=true
