{
  "name": "@ctp/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:dev": "nest start --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "openapi": "ts-node --transpile-only scripts/export-openapi.ts",
    "test": "jest",
    "loadtest": "ts-node --transpile-only loadtest/run.ts",
    "db:demo-orders": "ts-node --transpile-only prisma/demo-orders.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false,
          "tsconfig": {
            "isolatedModules": true,
            "module": "commonjs",
            "target": "ES2022",
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "esModuleInterop": true
          }
        }
      ]
    },
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "testTimeout": 120000,
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "maxWorkers": 1,
    "forceExit": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "autocannon": "^9.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
