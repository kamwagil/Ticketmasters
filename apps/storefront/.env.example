# URL of the central ticketing API, as reachable from this server (never from the browser).
API_URL=http://localhost:4000

# Host -> storefront API key. SERVER-SIDE ONLY: never prefix with NEXT_PUBLIC_.
# The request's Host header selects the key; the central API derives the brand from the key
# and checks that the host is a verified domain of that brand.
# The values below are the local development keys created by the demo seed.
STOREFRONT_KEYS={"tamasha.localhost:3100":"sfk_dev_tamasha_local_only_do_not_use_in_production","gigpoa.localhost:3100":"sfk_dev_gigpoa_local_only_do_not_use_in_production","uwanja.localhost:3100":"sfk_dev_uwanja_local_only_do_not_use_in_production","sherehe.localhost:3100":"sfk_dev_sherehe_local_only_do_not_use_in_production","pulsepass.localhost:3100":"sfk_dev_pulsepass_local_only_do_not_use_in_production"}
